# Local devnet only: services read hex private keys from these variables (never from the command line).
# Use anvil's pre-funded accounts; never put a key that holds real funds here (use --keystore for those).
ROLLUP_RPC_URL=http://127.0.0.1:<anvil port>
# Written by `rollup-cli deploy` and read by every service.
ROLLUP_DEPLOYMENT=deployment.json
DEPLOYER_KEY=
SEQUENCER_KEY=
PROPOSER_KEY=
CHALLENGER_KEY=
USER_KEY=
# Password of the keystore passed with --keystore <file>.
ROLLUP_KEYSTORE_PASSWORD=
