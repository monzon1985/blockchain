        { "tool": "foundryInvariant", "id": "invariant_sharePriceMonotonic" },
        { "tool": "medusa", "id": "property_vaultRoundingFavorsVault" },
        { "tool": "medusa", "id": "property_sharePriceMonotonic" },
        { "tool": "halmos", "id": "check_withdrawNeverUnderburnsShares" }
