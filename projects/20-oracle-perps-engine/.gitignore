/keeper/bin/
/keeper/signer
/keeper/keeper
# `forge script` broadcast logs (the root `broadcast/*/31337/` rule is anchored to the repository root)
/contracts/broadcast/
# Files created by the README "Running the pieces by hand" sequence: encrypted demo keystores and their password
# file, the anvil log and the address files written by the signers and the keeper
/keeper/ks/
/keeper/anvil.log
/keeper/*.addr
