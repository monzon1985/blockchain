{
  "name": "erc7683-intents-solver",
  "version": "0.1.0",
  "private": true,
  "description": "Solver bot, header relayer, mailbox relayer and watchtower for the two-chain ERC-7683 intents system.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "gen-abi": "node scripts/gen-abi.ts",
    "capture-proofs": "node scripts/capture-proofs.ts",
    "solver": "node src/main.ts",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "viem": "2.57.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
