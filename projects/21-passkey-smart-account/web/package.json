    "e2e:chain": "node scripts/e2e-chain.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.57.0",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "5.9.3"
  }
}
