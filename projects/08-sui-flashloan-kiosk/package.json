{
  "name": "sui-flashloan-kiosk",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript PTB builders and localnet e2e for the flash_kiosk Sui Move package: hot-potato flash-loan arbitrage and policy-enforced Kiosk purchases.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "e2e": "vitest run --project e2e",
    "vectors": "tsx scripts/gen-vectors.ts",
    "vectors:check": "tsx scripts/gen-vectors.ts --check",
    "move:coverage": "node scripts/check-move-coverage.mjs --min 90",
    "move:compile-fail": "node scripts/compile-fail.mjs"
  },
  "dependencies": {
    "@mysten/sui": "2.33.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mysten/prettier-plugin-move": "0.4.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
