      "exploits": ["SC05DuplicateBatchExploit.test_exploit_duplicateAssetDoubleCount"],
      "regressions": ["SC05DuplicateBatchRegression.test_regression_duplicateAssetRejected"],
      "signals": [
        { "tool": "foundryInvariant", "id": "invariant_poolSolvency" },
        { "tool": "medusa", "id": "property_poolSolvency" }
      ],
      "triage": "Reduced counterexamples are batches whose asset list repeats a token: settlement writes the token's reserve once per index and the stale last write leaves the recorded reserve above the balance."
    },
    {
