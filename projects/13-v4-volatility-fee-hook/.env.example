# Inputs for script/DeployVolatilityFeeHook.s.sol. The deployer key never goes here: sign with a Foundry keystore,
#   forge script script/DeployVolatilityFeeHook.s.sol --rpc-url <url> --account <keystore-name> --broadcast
POOL_MANAGER=0x0000000000000000000000000000000000000000
HOOK_OWNER=0x0000000000000000000000000000000000000000
# Optional fee-curve overrides (defaults shown). Range-checked with SafeCast: an out-of-range value reverts.
ALPHA_WAD=100000000000000000
FEE_SLOPE_PIPS=500
SURCHARGE_SLOPE_PIPS=250
MAX_SURCHARGE_PIPS=5000
