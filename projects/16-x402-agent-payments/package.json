{
  "name": "x402-agent-payments",
  "version": "1.0.0",
  "private": true,
  "description": "Local x402 v2 pay-per-call marketplace: untrusted facilitator, ERC-7579 budget-bounded agent accounts, receipt-backed ERC-8004 reputation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "abis": "tsx scripts/gen-abis.ts",
    "abis:check": "tsx scripts/gen-abis.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e": "vitest run --project e2e",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/demo/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.11",
    "viem": "2.57.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
