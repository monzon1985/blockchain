# Generated by tools run in this project (the root .gitignore covers out/, cache/, dependencies/, node_modules/).
# Medusa corpus, coverage and call sequences (main and reachability configs)
medusa-corpus/
medusa-corpus-reach/
# crytic-compile export used by Slither and Medusa
crytic-export/
slither_results.json
# forge script broadcasts for the local chains (1001/1002) and any other chain
broadcast/
# Solver journals (node:sqlite, WAL mode)
*.db
*.db-wal
*.db-shm
*.db.mailbox
*.db.mailbox-wal
*.db.mailbox-shm
# Solver feed directory used for local runs
solver/feed/
# Real configs hold RPC URLs, which often embed provider API keys: only config.example.json is committed
solver/config.json
solver/config.local.json
solver/*.local.json
# Coverage reports (vitest in solver/, forge coverage at the project root)
solver/coverage/
lcov.info
# Scratch fixtures captured by `npm run capture-proofs` (default) and by CI (the committed one is
# test/fixtures/anvil-proofs.json, replaced only with --update-committed)
test/fixtures/anvil-proofs.capture.json
test/fixtures/anvil-proofs.ci.json
