# Inputs for script/DeployAllocatorVault.s.sol. The deployer key never goes here: sign with a Foundry keystore,
#   forge script script/DeployAllocatorVault.s.sol --rpc-url <url> --account <keystore-name> --broadcast
# The zeros below are placeholders: the script refuses to broadcast while ADMIN, CURATOR, ALLOCATOR or GUARDIAN is
# zero, or while GUARDIAN equals CURATOR.
ASSET=0x0000000000000000000000000000000000000000
# Receives the AccessManager admin role; the deployer renounces its own.
ADMIN=0x0000000000000000000000000000000000000000
CURATOR=0x0000000000000000000000000000000000000000
ALLOCATOR=0x0000000000000000000000000000000000000000
# Must differ from the curator (it vetoes the curator's timelocked changes); use a separate multisig.
GUARDIAN=0x0000000000000000000000000000000000000000
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
# Optional (defaults shown). Fees and the growth limit are WAD values.
VAULT_NAME="Curated Allocator Vault"
VAULT_SYMBOL=cAV
PERFORMANCE_FEE=100000000000000000
MANAGEMENT_FEE=0
PRICE_GROWTH_LIMIT=250000000000000000
