{
  "name": "hardened-amm-web",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js 16 + wagmi 3 swap and liquidity dApp for the hardened constant-product AMM.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "wagmi:generate": "wagmi generate",
    "format": "prettier --write .",
    "wagmi:check": "wagmi generate && git diff --exit-code -- src/generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.57.0",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@wagmi/cli": "2.10.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
