{
  "name": "vesting-stream-nfts-hardhat3",
  "version": "1.0.0",
  "private": true,
  "description": "Linear-cliff, tranched and piecewise vesting streams as ERC-721s with fully on-chain SVG art, built on Hardhat 3 + viem.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "test:ci": "hardhat test solidity --test-profile ci",
    "coverage": "hardhat test --coverage",
    "coverage:check": "node scripts/check-coverage.ts 100",
    "snapshot": "hardhat test solidity --snapshot",
    "snapshot:check": "hardhat test solidity --snapshot-check",
    "gas:check": "hardhat run scripts/gas-check.ts",
    "gas:update": "hardhat run scripts/gas-check.ts",
    "golden:update": "hardhat test nodejs test/integration/golden.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.ts\" eslint.config.js",
    "format:check": "prettier --check \"**/*.ts\" eslint.config.js",
    "fmt:sol": "forge fmt contracts test/solidity",
    "fmt:sol:check": "forge fmt --check contracts test/solidity",
    "slither": "slither contracts/VestingStreams.sol --config-file slither.config.json && slither contracts/StreamRenderer.sol --config-file slither.config.json && slither contracts/demo/DemoToken.sol --config-file slither.config.json",
    "mutation": "node scripts/mutation.ts",
    "demo": "hardhat run scripts/demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.1.1",
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.3",
    "@nomicfoundation/ignition-core": "3.1.9",
    "@openzeppelin/contracts": "5.7.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fast-xml-parser": "5.11.2",
    "fast-xml-validator": "1.4.2",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "3.18.0",
    "prettier": "3.9.9",
    "solady": "0.1.26",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "viem": "2.57.1"
  }
}
