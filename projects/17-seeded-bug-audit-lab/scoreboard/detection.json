      "signals": [
        { "tool": "foundryInvariant", "id": "invariant_treasuryNeedsDurableStake" },
        { "tool": "medusa", "id": "property_treasuryNeedsDurableStake" },
        { "tool": "halmos", "id": "check_flashMintCannotPassEmergencyQuorum" },
