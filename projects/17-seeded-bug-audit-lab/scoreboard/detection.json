{
  "rule": "A tool is credited with a bug only when (1) its signal is present in the vulnerable-build evidence, (2) the same signal is absent from the fixed-build evidence, and (3) the auditor traced the signal to the bug's root cause, recorded below. Slither signals are keyed by check, function and (for kestrel-* detectors) source, and must point at one of the bug's sites; property signals are keyed by invariant/property name. Every signal that fires on v1 and not on v2 must be attributed to a bug or listed under `unattributed` with a reason. scripts/scoreboard.mjs --check enforces all of this against scoreboard/evidence/.",
  "tools": {
    "foundryInvariant": { "label": "Foundry inv.", "evidence": "foundry-invariants" },
    "medusa": { "label": "Medusa", "evidence": "medusa" },
    "halmos": { "label": "Halmos", "evidence": "halmos" },
    "slitherStd": { "label": "Slither (std)", "evidence": "slither", "custom": false },
    "slitherCustom": { "label": "Slither (custom)", "evidence": "slither", "custom": true }
  },
  "bugs": [
    {
      "id": "SC01",
      "finding": "H-05",
      "owasp": "SC01:2026 Access Control",
      "title": "Unprotected reward-rate setter drains the reward reserve",
      "sites": ["KestrelPool.setRewardRate(uint256)"],
      "exploits": ["SC01RewardSetterExploit.test_exploit_unprotectedRewardRateDrainsReserve"],
      "regressions": ["SC01RewardSetterRegression.test_regression_rewardRateIsOwnerGated"],
      "signals": [
        { "tool": "foundryInvariant", "id": "invariant_privilegedActionsOwnerOnly" },
        { "tool": "medusa", "id": "property_privilegedActionsOwnerOnly" }
      ],
      "triage": "The counterexample is a non-owner actor whose setRewardRate call succeeded; the only owner-only entry point without onlyOwner is setRewardRate."
    },
    {
      "id": "SC02",
      "finding": "M-01",
      "owasp": "SC02:2026 Business Logic",
      "title": "Swap fee bypassed through the batch path",
      "sites": ["KestrelPool._batchStepOut(address,address,uint256,uint256,uint256)"],
      "exploits": ["SC02FeeBypassExploit.test_exploit_batchPathBypassesFee"],
      "regressions": [
        "SC02FeeBypassRegression.test_regression_batchChargesTheFee",
        "SC02FeeBypassRegression.testFuzz_regression_batchMatchesQuote"
      ],
      "signals": [
        { "tool": "foundryInvariant", "id": "invariant_batchMatchesSingleSwap" },
        { "tool": "medusa", "id": "property_batchMatchesSingleSwap" }
      ],
      "triage": "On the 18-decimal main pool the batch output exceeded the single-swap quote by ~0.3% of the input, the swap fee; rounding cannot differ at scale 1, so the excess is the missing fee."
    },
    {
      "id": "SC03",
      "finding": "H-01",
      "owasp": "SC03:2026 Price Oracle Manipulation",
      "title": "Lending values collateral at the AMM spot price",
      "sites": ["KestrelLending.collateralValue(address)"],
      "exploits": ["SC03SpotOracleExploit.test_exploit_spotPumpBorrowsTheMarket"],
      "regressions": [
        "SC03SpotOracleRegression.test_regression_pumpDoesNotMoveValuation",
        "SC03SpotOracleRegression.test_regression_valuationIgnoresSameBlockSwap"
      ],
      "signals": [
        { "tool": "foundryInvariant", "id": "invariant_valuationIgnoresSameBlockSwaps" },
        { "tool": "medusa", "id": "property_valuationIgnoresSameBlockSwaps" },
        {
          "tool": "slitherCustom",
          "id": "kestrel-spot-price-collateral@KestrelLending.collateralValue(address)#spotPrice0In1"
        }
      ],
      "triage": "A same-block swap changed collateralValue; the detector names the source, pool.spotPrice0In1, which disappears once the market reads the TWAP oracle."
    },
    {
      "id": "SC04",
