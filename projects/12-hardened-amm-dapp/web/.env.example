# Runtime configuration read by the Next.js server on every request (src/lib/runtime-config.ts).
# scripts/dev.mjs and scripts/e2e-chain.mjs set all of these for you; there are no secrets in this app.

# JSON-RPC endpoint of the chain (anvil on a port chosen at runtime).
AMM_RPC_URL=http://127.0.0.1:<anvil-port>

# Deployment manifest written by contracts/script/DeployLocal.s.sol.
AMM_DEPLOYMENT_FILE=deployments/local.json

# 1 enables wagmi's mock connector bound to anvil's unlocked dev accounts. Local chains only.
AMM_ENABLE_MOCK_CONNECTOR=1

# Comma-separated unlocked anvil accounts the mock connector exposes (public addresses, no keys).
AMM_MOCK_ACCOUNTS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
