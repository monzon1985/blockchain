# Copy to .env (never committed; the repository ignores .env*) for local runs of the off-chain actors and the
# deploy scripts. Keys are read from the environment only; deployment scripts use a Foundry keystore (--account).
# Foundry loads .env by itself. Node does NOT: export the variables in your shell, or start the actors with
#   cd solver && node --env-file=../.env src/main.ts --config config.local.json --role solver

# Solver (fills and settlement transactions on both chains)
SOLVER_PRIVATE_KEY=
# Header relayer and mailbox relayer (hold the relayer roles in the AccessManagers)
RELAYER_PRIVATE_KEY=
# Watchtower (disputes fraudulent optimistic claims)
WATCHER_PRIVATE_KEY=

# Deploy scripts (see script/Deploy.s.sol)
# Final AccessManager admin on both chains (a timelock or multisig; defaults to the deployer), its execution delay,
# and the grant delay of the relayer roles, in seconds. The delay protects users only if it is longer than the
# longest order lifetime plus REFUND_GRACE.
ADMIN=
ADMIN_EXECUTION_DELAY=259200
RELAYER_GRANT_DELAY=259200
MAILBOX_RELAYER=
HEADER_RELAYER=
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
REFUND_GRACE=3600
BOND_TOKEN=
BOND=
CHALLENGE_WINDOW=1800
DEST_CHAIN_ID=
DEST_SETTLER=
DEST_REPORTER=
REPORTER=
ORIGIN_CHAIN_ID=
ORIGIN_MAILBOX_MODULE=
